{
  "name": "crownshire-rts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crownshire — a medieval pixel-art 4-kingdom free-for-all RTS for desktop and mobile browsers",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx tools/headless.ts"
  },
  "dependencies": {
    "@fontsource/jacquarda-bastarda-9": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "*",
    "tsx": "*",
    "typescript": "*",
    "vite": "*",
    "vitest": "*"
  }
}
